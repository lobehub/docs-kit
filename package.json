{
  "name": "@lobehub/docs-kit",
  "version": "6.3.0",
  "description": "Reusable documentation toolkit and lobedocs CLI for LobeHub component libraries",
  "keywords": [
    "lobehub",
    "documentation",
    "docs",
    "react-router",
    "vite",
    "mdx"
  ],
  "homepage": "https://github.com/lobehub/docs-kit",
  "bugs": {
    "url": "https://github.com/lobehub/docs-kit/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobehub/docs-kit.git"
  },
  "license": "MIT",
  "author": "LobeHub <i@lobehub.com>",
  "type": "module",
  "bin": {
    "lobedocs": "bin/lobedocs.mjs"
  },
  "files": [
    "bin",
    "react-router-config.ts",
    "site",
    "src",
    "vite.config.ts"
  ],
  "scripts": {
    "build:playground": "pnpm --filter docs-kit-playground run build",
    "dev": "pnpm --filter docs-kit-playground run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "release": "semantic-release",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsrs --noEmit"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@lobehub/ui": "^6.0.0",
    "@mdx-js/rollup": "3.1.1",
    "@stylexjs/stylex": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "cheerio": "^1.2.0",
    "code-inspector-plugin": "^2.0.9",
    "es-toolkit": "^1.52.0",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next-themes": "^0.4.6",
    "pagefind": "1.5.2",
    "react-live": "5.0.1",
    "rehype-raw": "^7.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "remark-parse": "^11.0.0",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@lobehub/lint": "^2.1.6",
    "@mdx-js/mdx": "^3.1.1",
    "@react-router/dev": "8.4.0",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^5.0.4",
    "conventional-changelog-gitmoji-config": "1.5.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.4.0",
    "semantic-release": "^25.0.9",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "^4.23.15",
    "vite": "8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@react-router/dev": "^8.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.2.0",
    "tsx": "^4.23.0",
    "vite": "^8.1.4"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.22.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  }
}
