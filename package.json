{
  "name": "@lobehub/docs-kit",
  "version": "6.4.1",
  "description": "Reusable documentation toolkit and lobedocs CLI for LobeHub component libraries",
  "keywords": [
    "lobehub",
    "documentation",
    "docs",
    "react-router",
    "vite",
    "mdx"
  ],
  "homepage": "https://github.com/lobehub/docs-kit",
  "bugs": {
    "url": "https://github.com/lobehub/docs-kit/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobehub/docs-kit.git"
  },
  "license": "MIT",
  "author": "LobeHub <i@lobehub.com>",
  "type": "module",
  "bin": {
    "lobedocs": "bin/lobedocs.mjs"
  },
  "files": [
    "bin",
    "react-router-config.ts",
    "vite-extension.ts",
    "site",
    "src",
    "vite.config.ts"
  ],
  "scripts": {
    "build:playground": "pnpm --filter docs-kit-playground run build",
    "dev": "pnpm --filter docs-kit-playground run dev",
    "lint": "eslint .",
    "lint:circular": "dpdm \"{src,site}/**/*.{ts,tsx}\"  --warning false  --tree false  --exit-code circular:1  -T true",
    "lint:fix": "eslint . --fix",
    "lint:md": "remark . --quiet --frail --output",
    "lint:style": "stylelint \"{src,site,playground}/**/*.{ts,tsx}\" --fix",
    "prepare": "husky",
    "prettier": "prettier -c --write --no-error-on-unmatched-pattern \"**/**\"",
    "release": "semantic-release",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsrs --noEmit"
  },
  "lint-staged": {
    "*.{md,mdx}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.json": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx}": [
      "prettier --write",
      "stylelint --fix",
      "eslint --fix"
    ],
    "*.{mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{ts,tsx}": [
      "prettier --parser=typescript --write",
      "stylelint --fix",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@lobehub/ui": "^6.15.2",
    "@mdx-js/rollup": "3.1.1",
    "@stylexjs/stylex": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "cheerio": "^1.2.0",
    "code-inspector-plugin": "^2.0.9",
    "es-toolkit": "^1.53.2",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next-themes": "^0.4.6",
    "pagefind": "1.5.2",
    "react-live": "5.0.1",
    "rehype-raw": "^7.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "remark-parse": "^11.0.0",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@lobehub/lint": "^2.1.7",
    "@mdx-js/mdx": "^3.1.1",
    "@react-router/dev": "8.4.0",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^5.1.0",
    "conventional-changelog-gitmoji-config": "1.5.2",
    "dpdm": "^4.3.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.4.0",
    "remark": "^15.0.1",
    "remark-cli": "^12.0.1",
    "semantic-release": "^25.0.9",
    "stylelint": "^16.26.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "^4.23.15",
    "vite": "8.3.4",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@react-router/dev": "^8.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.2.0",
    "tsx": "^4.23.0",
    "vite": "^8.1.4"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.22.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  }
}
