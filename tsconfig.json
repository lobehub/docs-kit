{
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "bin",
    "site",
    "src",
    "playground/src",
    "playground/docs.config.ts",
    "react-router-config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
